on boot
# Governor interactive reactivo.
#
# Valores optimizados basado en LOS19 reference para Exynos 3475.
# balance entre rendimiento y temperatura/batería.
    write /sys/devices/system/cpu/cpufreq/interactive/timer_rate 20000
    write /sys/devices/system/cpu/cpufreq/interactive/timer_slack 80000
    write /sys/devices/system/cpu/cpufreq/interactive/min_sample_time 20000
    write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 1300000
    write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 75
    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "70 897000:80 1300000:95"
    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay "40000"
    write /sys/devices/system/cpu/cpufreq/interactive/io_is_busy 1
    write /sys/devices/system/cpu/cpufreq/interactive/boost 0

# Kernel Workqueue
    chown system system /sys/module/workqueue/parameters/power_efficient
    chmod 0664 /sys/module/workqueue/parameters/power_efficient
