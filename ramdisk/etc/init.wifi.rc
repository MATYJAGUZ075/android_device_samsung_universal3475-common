# Wi-Fi init file

on post-fs-data
    # give system access to wpa_supplicant.conf for backup and restore
    mkdir /data/misc/wifi 0770 wifi system
    chmod 0660 /data/misc/wifi/wpa_supplicant.conf
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/log/ 0770 wifi system

    # Create the directories used by the Wireless subsystem
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

    # for WIFI TRP/TIS
    # PSM (Proximity/power save): si el "apagado de WiFi" viene de un
    # .info!=0 (mode_stand_alone heredado del factory), el driver entra en
    # powersave agresivo y descarta el beacon -> DEAUTH_LEAVING en bucle.
    # Escribir 0 fuerza mode_off. Tambien testeable en runtime:
    #   echo 0 > /data/.psm.info   (con root, sin rebuild)
    write /data/.psm.info 0
    chown system root /data/.psm.info
    chmod 0664 /data/.psm.info

    # for WIFI Antenna Selection
    chown system root /data/.ant.info
    chmod 0664 /data/.ant.info
    write /data/.cid.info 0
    write /data/.rev 0
    restorecon /data/.cid.info
    restorecon /data/.rev

    # for WIFI Version
    write /data/.wifiver.info 0
    chown system root /data/.wifiver.info
    chmod 0666 /data/.wifiver.info

    # for WIFI Cert
    chmod 0664 /data/.bustxglom.info
    chmod 0664 /data/.roamoff.info
    chmod 0664 /data/.frameburst.info
    chmod 0664 /data/.txbf.info
    # for WIFI MAC address
    mkdir /efs/wifi 0775 radio system
    chown system wifi /efs/wifi/.mac.info
    chmod 0660 /efs/wifi/.mac.info

    # Set permissions for firmware path control
    chown wifi wifi /sys/module/dhd/parameters/firmware_path

on boot
    setprop wifi.interface wlan0

    # Pcie WiFi T-put setting
    write /sys/class/net/wlan0/queues/rx-0/rps_cpus 00

    #write /proc/sys/net/ipv4/tcp_adv_win_scale 2

# Run deferred initcalls of builtin kernel modules (bcmdhd)
service wifiloader /vendor/bin/wifiloader
    class main
    oneshot

# NOTA: el servicio wpa_supplicant NO se define aqui a proposito. Este bloque
# declaraba interfaces HIDL (supplicant@1.0/1.1/1.2), que en Android 13 ya no
# existen: el stack de WiFi es AIDL. Con esos nombres el servicio no lograba
# registrar la interface y init reportaba, medido en el telefono:
#
#   init: Control message: Could not find
#     'aidl/android.hardware.wifi.supplicant.ISupplicant/default'
#     for ctl.interface_start from pid: (/system/bin/servicemanager)
#
# Sin este bloque, el rc que trae AOSP lo sirve con los nombres AIDL correctos.

service macloader /vendor/bin/macloader
    class main
    oneshot

on property:init.svc.macloader=stopped
    chown system root /data/.cid.info
    chmod 0664 /data/.cid.info
    chown system root /data/.rev
    chmod 0664 /data/.rev
# end of WiFi MFG (TestMode)

#service olsrd /system/bin/olsrd -f /etc/wifi/olsrd.conf
#    class main
#    disabled
#    oneshot

# El driver Broadcom (dhd) carga un firmware distinto segun el modo. Sin esto el
# modulo arranca sin firmware_path correcto y nunca levanta la interfaz WLAN:
# medido sin estos triggers no aparecia wlan0 en /sys/class/net.
on property:init.svc.wificond=running
    write /sys/module/dhd/parameters/firmware_path /vendor/etc/wifi/bcmdhd_sta.bin

on property:init.svc.hostapd=running
    write /sys/module/dhd/parameters/firmware_path /vendor/etc/wifi/bcmdhd_apsta.bin

on property:init.svc.hostapd=stopped
    write /sys/module/dhd/parameters/firmware_path /vendor/etc/wifi/bcmdhd_sta.bin
