# Android fstab file — universal3475 (LineageOS 20)
# Cambios respecto a 17.1:
#  - ELIMINADO el cifrado: FDE footer no es soportado en Android 13 y el
#    kernel 3.10 no tiene FBE. /data se monta SIN cifrar (decisión del
#    análisis, ver ANALISIS_LINEAGE20_REFERENCIAS.md).
#  - Añadida entrada zram swap (patrón Exynos7420 LOS20).
#
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                                  <mnt_point> <type>  <mnt_flags and options>                                                         <fs_mgr_flags>
# SYSTEM se monta ro, pero sin noload ni block_validity.
#
# noload = montar sin reproducir el journal. Si quedo metadata pendiente de una
# sesion anterior (por ejemplo una entrada de directorio apuntando a un inodo
# marcado como borrado), el fs se ve inconsistente desde el arranque.
# errors=panic convertia ese error en un fallo de arranque, dejando el telefono
# en bootloop en vez de arrancar con un aviso.
# block_validity es un parche propietario que valida un checksum por bloque; con
# el kernel 3.10 de este device devolvia lecturas corruptas de inodos concretos.
#
# Medido en el telefono con este arbol (run 37876287662): con las opciones
# anteriores el arranque caia en un crash-loop de system_server con
# "UnsatisfiedLinkError: dlopen failed: library \"libcutils.so\" not found:
# needed by /apex/com.android.adbd/lib/libadb_pairing_server.so in namespace
# com_android_adbd", acompañado de
# "EXT4-fs error (device mmcblk0p20): ext4_lookup:1528: inode #72: deleted inode
# referenced: 81 at parent inode: 72" (72 = dir lib/ del apex adbd,
# 81 = symlink libcutils.so). El inodo danado cambiaba entre arranques, lo que
# descarta un sector fisico malo.
#
# OJO con el flag fs_mgr "recoveryonly": hacia que /system NO se montara en el
# arranque normal (solo en recovery), y por eso el zygote veia un arbol de
# ficheros incompleto y fallaba al precargar
# "android.app.SystemServiceRegistry" con "NoClassDefFoundError: Class not
# found using the boot class loader". Sin ese flag, /system se monta siempre.
/dev/block/platform/13540000.dwmmc0/by-name/SYSTEM      /system     ext4    ro,noatime,errors=remount-ro,data=ordered                          wait
/dev/block/platform/13540000.dwmmc0/by-name/BOOT        /boot       emmc    defaults                                                                        defaults
/dev/block/platform/13540000.dwmmc0/by-name/OTA         /misc       emmc    defaults                                                                        defaults
/dev/block/platform/13540000.dwmmc0/by-name/RECOVERY    /recovery   emmc    defaults                                                                        defaults
/dev/block/platform/13540000.dwmmc0/by-name/CPEFS       /cpefs      ext4    nosuid,nodev,noatime,noauto_da_alloc,discard,journal_async_commit,errors=panic  wait,check
/dev/block/platform/13540000.dwmmc0/by-name/EFS         /efs        ext4    nosuid,nodev,noatime,noauto_da_alloc,discard,journal_async_commit,errors=panic  wait,check
/dev/block/platform/13540000.dwmmc0/by-name/CACHE       /cache      ext4    nosuid,nodev,noatime,noauto_da_alloc,discard,journal_async_commit,errors=panic  wait,check
/dev/block/platform/13540000.dwmmc0/by-name/USERDATA    /data       ext4    nosuid,nodev,noatime,noauto_da_alloc,discard,journal_async_commit,errors=panic  wait,check,latemount

# VOLD (sdcard1 sin encryptable=userdata: cifrado removido)
/devices/13560000.dwmmc2/mmc_host/mmc*    auto    vfat    defaults    voldmanaged=sdcard1:auto
/devices/13510000.usb/usb*                auto    auto    defaults    voldmanaged=usb:auto
/devices/13520000.usb/usb*                auto    auto    defaults    voldmanaged=usb:auto

# ZRAM
/dev/block/zram0                          none    swap    defaults    zramsize=536870912
