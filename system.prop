# System properties comunes universal3475 (formato LOS20: system.prop,
# consumido via TARGET_SYSTEM_PROP en BoardConfigCommon.mk).

# Audio
af.fast_track_multiplier=1
audio_hal.force_voice_config=wide

# Display
ro.opengles.version=196610

# HWC
debug.sf.latch_unsignaled=1

# Wi-Fi
wifi.interface=wlan0
wifi.direct.interface=p2p-dev-wlan0
net.tethering.noprovisioning=true

# Low RAM flag (1.5GB)
ro.config.low_ram=true

# Media
debug.stagefright.ccodec=0

# Network — initial receive window size in segments
net.tcp.default_init_rwnd=60

# ADB / USB
# El kernel 3.10 del Exynos 3475 no tiene CONFIG_USB_FUNCTIONFS (esta
# desactivado en el defconfig), asi que adbd no puede usar el modo FunctionFS
# non-blocking. Sin esto adbd arranca pero nunca enumera, y el movil no aparece
# por ADB durante el arranque de system (en TWRP si funciona porque usa su
# propio entorno). ro.adb.nonblocking_ffs=0 desactiva ese camino y hace que
# adbd use la API synchronous de FFS.
# Comprobado: el defconfig de este kernel es practicamente identico al de
# lineage-17.1, donde ADB si funciona, con estas mismas props.
ro.adb.nonblocking_ffs=0
persist.adb.nonblocking_ffs=0
# Modo de compatibilidad AIO de FFS, necesario junto a lo anterior.
sys.usb.ffs.aio_compat=1
# Configuracion USB por defecto: MTP + ADB.
persist.sys.usb.config=mtp,adb
