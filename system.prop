# System properties comunes universal3475 (formato LOS20: system.prop,
# consumido via TARGET_SYSTEM_PROP en BoardConfigCommon.mk).

# Audio
af.fast_track_multiplier=1
audio_hal.force_voice_config=wide

# Display
ro.opengles.version=196610

# HWC
debug.sf.latch_unsignaled=1

# Wi-Fi
wifi.interface=wlan0
wifi.direct.interface=p2p-dev-wlan0
net.tethering.noprovisioning=true

# Low RAM flag (1.5GB)
ro.config.low_ram=true

# Media
debug.stagefright.ccodec=0

# Network — initial receive window size in segments
net.tcp.default_init_rwnd=60

# ADB / USB
# ADVERTENCIA: estas props son de la era Android 12. En Android 13 adbd se movio
# al APEX com.android.adbd y YA NO LAS LEE: el binario no contiene ni
# "nonblocking_ffs" ni "ffs.aio_compat", y usa AIO de forma incondicional
# (ScopedAioContext::Create). Medido en este device: con las cuatro props puestas
# y cargadas, adbd arranca, FUNCTIONFS hace bind y el estado es mtp,adb, pero
#
#   UsbFfs: connection terminated: failed to submit read: Invalid argument
#
# En el kernel, aio_read() sobre un fichero sin soporte AIO hace el read
# sincrono y, si devuelve 0 bytes, lo traduce a -EINVAL. El read de ep0 en
# functionfs devuelve 0 cuando no hay paquete pendiente, de ahi el EINVAL, y adbd
# destruye su propio transporte (el host ve el movil como "offline").
#
# Es decir: NO arreglan ADB en A13. Un fix real exige parche en adbd (tratar el
# EINVAL como EAGAIN) o en el kernel (AIO en los endpoints de functionfs), no un
# device tree. Se dejan porque son inocuas y hacen falta si alguna vez se vuelve
# a A12, y persist.sys.usb.config si es la config USB por defecto que queremos.
ro.adb.nonblocking_ffs=0
persist.adb.nonblocking_ffs=0
# Modo de compatibilidad AIO de FFS (solo A12; ignorado por el adbd de A13).
sys.usb.ffs.aio_compat=1
# Configuracion USB por defecto: MTP + ADB.
persist.sys.usb.config=mtp,adb

# ART JIT
# dalvik.vm.usejit=false y usejitprofiles=false (FIX-036).
#
# El kernel 3.10 del Exynos 3475 no tiene memfd_create(): el mecanismo de
# memoria de A13 es memfd y no el ashmem antiguo. Medido:
#   I zygote: memfd_create failed: Function not implemented, no memfd support
#   W system_server: Could not create private region after zygote fork:
#     Failed to initialize dual view JIT. memfd_create() error: Function not implemented
#
# Sin memfd_create, ART no puede inicializar el JIT dual-view y el hilo del pool
# de JIT revienta con SIGSEGV. Con crash_dump ya funcionando (kernel con vndbinder
# y ramoops) se obtiene el tombstone, 11 veces por arranque:
#   Fatal signal 11 (SIGSEGV), code 1 (SEGV_MAPERR), fault addr 0x4
#     in tid ... (Jit thread pool), pid ... (system_server)
#   I Zygote: Process ... exited due to signal 11 (Segmentation fault)
#
# system_server muere por SIGSEGV en el JIT, no por ANR ni por OOM, asi que
# zygote reinicia cada ~14 s y nunca se llega a boot_completed. Con el JIT
# desactivado ART interpreta en vez de compilar, que es lento pero estable en un
# Cortex-A7.
#
# Coste: el rendimiento del interprete es notable. Es la unica via sin tocar el
# kernel; la alternativa seria backportar memfd_create a este 3.10.
dalvik.vm.usejit=false
dalvik.vm.usejitprofiles=false
