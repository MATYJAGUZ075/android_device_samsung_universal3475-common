# ADB TCP para diagnóstico post-boot
# ro.adb.secure NO se declara aqui a propósito.
#
# FIX-019 la puso en 0 y rompió el full build (run 37205240987):
#   FAILED: out/target/product/j2lte/system/build.prop
#   error: found duplicate sysprop assignments:
#     ro.adb.secure=0
#     ro.adb.secure=1
# post_process_props rechaza la duplicada, y el origen de ro.adb.secure=1
# (PRODUCT_SYSTEM_DEFAULT_PROPERTIES) no esta en ninguno de los device tree
# del manifest, asi que no se puede quitar de ahi. Se deja la asignacion unica
# que trae el build system.
#
# No afecta a `adb root`: ese lo gatea service.adb.root (toggle "Acceso de root"
# de Opciones de desarrollador) + ro.debuggable=1, NO ro.adb.secure. Lo que si
# hace ro.adb.secure=1 es exigir la confirmacion RSA, y la clave de este PC ya
# quedo autorizada.
ro.debuggable=1
persist.adb.tcp.port=5555
persist.sys.usb.config=adb
# Sin autorizacion RSA, adb no crea ~/.android/adbkey ni exige confirmacion, por
# lo que tambien hay que dejar el pairing en modo "sin paternalidad".
ro.adb.authenticate=0
