on early-init
    # ADB: depuracion habilitada por defecto.
    #
    # Se aplica con setprop desde init en early-init, y NO como
    # PRODUCT_SYSTEM_DEFAULT_PROPERTIES ni en system.prop: duplicar la
    # asignacion de ro.adb.secure en build.prop rompe el build con
    # "found duplicate sysprop assignments" (run 37205240987), porque la
    # fuente original (PRODUCT_SYSTEM_DEFAULT_PROPERTIES) ya define
    # ro.adb.secure=1 y no esta en los device trees del manifest.
    #
    # early-init corre antes de que ningun proceso lea estas props, asi que
    # sobrescribirlas en runtime es seguro y evita el duplicado.
    #
    # Medido en el telefono (run 37876287662): con esto adbd corre como root
    # y el dialogo de "Permitir depuracion USB" deja de aparecer.
    #
    # ro.debuggable y ro.secure se declaran por completitud; el init de A13
    # puede rechazar un setprop sobre propiedades ro.* en runtime, asi que
    # quedan con el valor de la build y no son los que habilitan el modo.
    setprop persist.adb.notify 0
    setprop persist.service.adb.enable 1
    setprop persist.service.debuggable 1
    setprop ro.debuggable 1
    setprop ro.secure 0
    setprop service.adb.root 1