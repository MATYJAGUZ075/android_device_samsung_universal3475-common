cc_library_shared {
    name: "libstdc++",

    // V-7: legacy Samsung blobs (sensors.universal3475.so,
    // camera.vendor.exynos5.so) DT_NEEDED libstdc++.so, removed from
    // Android since L. Provides the minimal Itanium/EHABI runtime set.
    vendor: true,

    srcs: [
        "libstdc++.cpp",
    ],

    stl: "none",
}
